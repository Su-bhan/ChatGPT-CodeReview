{
  "name": "cr-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A Probot app",
  "author": "anc95",
  "license": "ISC",
  "type": "module",
  "homepage": "https://github.com//",
  "keywords": [
    "probot",
    "github",
    "probot-app",
    "code review"
  ],
  "scripts": {
    "start": "node -r dotenv/config ./dist/index.js",
    "test": "jest",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c rollup.config.cjs && ncc build src/github-action.cjs -o action",
    "kawnix:preflight": "node dist/kawnix-preflight.js",
    "build:lambda": "ncc build src/aws-lambda.cjs -o lambda"
  },
  "dependencies": {
    "@probot/adapter-aws-lambda-serverless": "^3.0.2",
    "@probot/adapter-github-actions": "^3.1.3",
    "@vercel/edge": "^0.2.7",
    "@types/jest": "^29.0.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.0.3",
    "loglevel": "^1.9.2",
    "minimatch": "^10.0.1",
    "node-fetch": "^3.3.0",
    "pg": "^8.23.1",
    "probot": "^12.2.4",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@vercel/ncc": "^0.36.1",
    "esbuild": "^0.17.19",
    "rollup": "^3.30.0",
    "rollup-plugin-esbuild": "^5.0.0",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/pino-std-serializers": "^4.0.0",
    "jest": "^29.0.0",
    "nock": "^13.0.5",
    "rollup-plugin-commonjs": "^10.1.0",
    "smee-client": "^1.2.2",
    "ts-jest": "^29.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
