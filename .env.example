# Google AI Studio API key
GEMINI_API_KEY=

# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=
PRIVATE_KEY=

# BOT settings
LANGUAGE=
MODEL=gemini-2.5-flash
temperature=
top_p=
max_tokens=
TARGET_LABEL=
MAX_PATCH_LENGTH=
PROMPT=Below there is a code diff please help me do a code review
IGNORE_PATTERNS=/node_modules,*.md # glob pattern or regex pattern to ignore files, separated by comma
INCLUDE_PATTERNS=*.js,*.ts # glob pattern or regex pattern to include files, separated by comma

# Kawnix provider endpoint
KAWNIX_PROVIDER_TOKEN=
KAWNIX_WORKER_TOKEN=
# Supabase PostgreSQL connection string. Prefer the Session Pooler string for
# hosted/serverless deployments; use the Direct connection only when IPv6 is
# available. Include ?sslmode=require.
DATABASE_URL=
# JSON object mapping the SHA-256 bearer owner ID to allowed repositories.
# Example: {"owner-hash":["organization/repository"]}
KAWNIX_REPOSITORY_ACCESS={}

# Kawnix review execution
# PRIVATE_KEY should contain the GitHub App PEM value.
# The provider requires pull-request read access and review write access
# only when publishing_mode is pull_request_review.
